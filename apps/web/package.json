    "test:contracts": "tsc --noEmit -p tsconfig.contracts.json"
  },
  "dependencies": {"react": "19.2.4", "react-dom": "19.2.4"},
  "devDependencies": {"vite": "7.3.7", "typescript": "5.9.3", "@types/react": "19.2.14", "@types/react-dom": "19.2.3", "openapi-typescript": "7.13.0"}
}
