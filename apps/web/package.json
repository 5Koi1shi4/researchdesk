{
  "name": "researchdesk-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "generate:contracts": "openapi-typescript ../../contracts/openapi.json -o src/generated/contracts.ts",
    "test:contracts": "tsc --noEmit -p tsconfig.contracts.json",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/documents.spec.mjs",
    "test:e2e:documents": "node tests/documents.e2e.mjs"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.64.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
