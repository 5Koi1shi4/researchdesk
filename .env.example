# Development placeholders only; copy to .env and replace before deployment.
COMPOSE_PROJECT_NAME=researchdesk-delivery
RESEARCHDESK_PORT=18085
POSTGRES_PASSWORD=researchdesk-dev-only
BUSINESS_DATABASE_PASSWORD=researchdesk-business-dev-only
RETRIEVAL_DATABASE_PASSWORD=researchdesk-retrieval-dev-only
SESSION_COOKIE_SECURE=false
SESSION_SECONDS=86400
MINIO_ROOT_USER=researchdesk-dev
MINIO_ROOT_PASSWORD=researchdesk-dev-only
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=replace-with-provider-model
OPENAI_API_KEY=
# Upload limits are enforced now and may only be tightened below these defaults.
MAX_FILE_BYTES=20971520
MAX_PDF_PAGES=200
MAX_DOCUMENTS_PER_PROJECT=50
# Generation limits are reserved for subsequent tasks.
MAX_CONCURRENT_RUNS_PER_USER=2
ANSWER_TIMEOUT_SECONDS=120
REPORT_TIMEOUT_SECONDS=300
ANSWER_MAX_OUTPUT_TOKENS=2000
REPORT_MAX_OUTPUT_TOKENS=6000
MAX_TRANSIENT_RETRIES=3
INTERNAL_SERVICE_TOKEN=researchdesk-internal-dev-token-change-before-production

# Production overlay only: restricted pre-provisioned bucket identity (never root).
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Direct TLS proxy overlay reads fullchain.pem and privkey.pem from this directory.
TLS_CERT_DIRECTORY=
RESEARCHDESK_TLS_PORT=18485

# Preserve this prefix when restoring into another Compose project.
RESEARCHDESK_IMAGE_PREFIX=researchdesk-delivery

# Keep both services in explicit demo mode until provider configuration is supplied.
GENERATION_MODE=demo

# Optional dated estimates for a matching real provider model; blank means unknown.
USAGE_PRICE_MODEL=
USAGE_INPUT_PRICE_PER_MILLION=
USAGE_OUTPUT_PRICE_PER_MILLION=
USAGE_PRICE_DATE=
USAGE_PRICE_CURRENCY=
